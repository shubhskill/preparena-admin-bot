if (payload.startsWith("admindismiss:")) {
  if (!isOwner(admin)) {
    await send(chatId, "⛔ Owner only.");
    return;
  }

  const targetId = Number(payload.split(":")[1]);

  if (!Number.isInteger(targetId)) {
    await send(chatId, "❌ Invalid admin ID.");
    return;
  }

  const { data: target, error: targetError } = await supabase
    .from("telegram_admins")
    .select("telegram_user_id, role")
    .eq("telegram_user_id", targetId)
    .maybeSingle();

  if (targetError) {
    console.error("admindismiss lookup error:", targetError);
    await send(chatId, "❌ Could not find this admin.");
    return;
  }

  if (!target) {
    await send(chatId, "❌ Admin not found.");
    return;
  }

  // Never allow owner account to be dismissed
  if (target.role === "owner") {
    await send(chatId, "⛔ Owner cannot be dismissed.");
    return;
  }

  await send(
    chatId,
    `⚠️ <b>Dismiss Admin?</b>\n\n` +
      `Are you sure you want to remove admin ` +
      `<code>${target.telegram_user_id}</code>?`,
    {
      reply_markup: {
        inline_keyboard: [
          [
            {
              text: "✅ Yes, Dismiss",
              callback_data: `${PREFIX}adminremove:${targetId}`
            }
          ],
          [
            {
              text: "❌ Cancel",
              callback_data: `${PREFIX}manageadmins`
            }
          ]
        ]
      }
    }
  );

  return;
}
